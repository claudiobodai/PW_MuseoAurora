@implements IDisposable

@inject NavigationManager NavigationManager

<div class="top-row navbar">
    <div class="navbar-brand-wrapper">
        <a class="navbar-brand-logo" href="">
            <span class="logo-m">M</span>
            <span class="logo-line"></span>
            <span class="logo-a">A</span>
        </a>
    </div>

    <nav class="nav-links">
        <NavLink class="nav-link" href="" Match="NavLinkMatch.All">Visit</NavLink>
        <NavLink class="nav-link" href="shows">Events</NavLink>
        <NavLink class="nav-link" href="operas">What's new</NavLink>
    </nav>

    <div class="nav-actions">
        <NavLink class="btn-tickets" href="tickets">Tickets</NavLink>
        <AuthorizeView>
            <Authorized>
                <form action="Account/Logout" method="post" style="display:inline;">
                    <AntiforgeryToken />
                    <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                    <button type="submit" class="nav-link btn-logout">Logout</button>
                </form>
            </Authorized>
            <NotAuthorized>
                <NavLink class="nav-link" href="Account/Login">Login</NavLink>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
